# Database
DATABASE_URL=postgres://dev:dev@localhost:5433/neva_local?sslmode=disable

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
CLERK_WEBHOOK_SECRET=whsec_your-webhook-secret

# Legacy JWT (for migration period only)
JWT_SECRET=your-local-jwt-secret-key

# Server
PORT=8080

# Email Service (Mailjet)
# Leave MAILJET_API_KEY empty to use mock email service for development
# Sign up at https://www.mailjet.com (6000 emails/month free)
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=luiz@labflux.app
MAILJET_FROM_NAME=LabFlux

# Frontend URL (for invitation links)
FRONTEND_URL=http://localhost:5174

# Invitation Settings
INVITATION_EXPIRY_DAYS=7

# For production with Neon
# DATABASE_URL=postgres://username:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
