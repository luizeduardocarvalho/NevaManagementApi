							"mode": "raw",
							"raw": "{\n  \"type\": \"user.created\",\n  \"data\": {\n    \"id\": \"user_12345\",\n    \"email_addresses\": [\n      {\n        \"email_address\": \"test@example.com\"\n      }\n    ],\n    \"first_name\": \"Test\",\n    \"last_name\": \"User\"\n  }\n}"
